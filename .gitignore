# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# --- pytest / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- AxiCavity-FEM が生成するもの ---
# solve / post の出力（HDF5 と、その隣に出るテキストサマリ）
*.h5
/samples/*.txt
# サンプルから作ったメッシュ・材料定義・バッチ実行の出力（samples/ には入力ファイルだけを置く）
/samples/*.msh
/samples/*.materials.json
/samples/*_batch/
# report コマンドの出力ディレクトリ
*_report/
# プロジェクトのデータフォルダ（メッシュ・結果の履歴）
*.axiproj.data/
# GUI / CLI が実行したコマンドの記録
command.log

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
